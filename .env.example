# ---------------------------------------------------------------------------
# INGANJI LIFE OS — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# --- AI assistant (optional) — enables the built-in AI advisor ---------------
# Either provider works. Gemini has a free tier.
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Email notifications (optional) — Resend ---------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- SMS notifications (optional) — Africa's Talking (Rwanda) ----------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# --- SMS notifications (optional) — Twilio (alternative to Africa's Talking) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
